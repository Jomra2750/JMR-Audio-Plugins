desc:JMR Audio - EQ One v1.5 (Stepped Bell EQ + HPF)
// Four stereo bell filters, discrete frequency and gain controls.
// Diagnostic: set LOW to 100 Hz and +12 dB to hear an obvious boost.
slider1:5<0,11,1{30,40,50,60,80,100,120,150,200,250,300,400}>-Low Frequency
slider2:0<-12,12,1>-Low Gain (dB)
slider3:5<0,9,1{100,150,200,300,400,500,700,1000,1500,2000}>-Low Mid Frequency
slider4:0<-12,12,1>-Low Mid Gain (dB)
slider5:4<0,8,1{800,1000,1500,2000,3000,4000,5000,6000,8000}>-High Mid Frequency
slider6:0<-12,12,1>-High Mid Gain (dB)
slider7:5<0,8,1{2000,3000,4000,5000,6000,8000,10000,12000,16000}>-High Frequency
slider8:0<-12,12,1>-High Gain (dB)
slider9:0<0,1,1{On,Bypass}>-Global Bypass
slider10:0<0,1,1{Off,On}>-High Pass Enable
slider11:0<0,4,1{40,75,125,220,400}>-High Pass Frequency
slider12:0<0,1,1{Bell,Shelf}>-Low Type
slider13:0<0,1,1{Bell,Shelf}>-High Type

@init
// Non-overlapping memory regions for coefficients and delay states.
c0=0;c1=8;c2=16;c3=24;
s0L=40;s1L=44;s2L=48;s3L=52;
s0R=56;s1R=60;s2R=64;s3R=68;
lf=128;lm=144;hm=160;hf=176;hpf=192;hc=32;hsL=72;hsR=76;
lf[0]=30;lf[1]=40;lf[2]=50;lf[3]=60;lf[4]=80;lf[5]=100;lf[6]=120;lf[7]=150;lf[8]=200;lf[9]=250;lf[10]=300;lf[11]=400;
lm[0]=100;lm[1]=150;lm[2]=200;lm[3]=300;lm[4]=400;lm[5]=500;lm[6]=700;lm[7]=1000;lm[8]=1500;lm[9]=2000;
hm[0]=800;hm[1]=1000;hm[2]=1500;hm[3]=2000;hm[4]=3000;hm[5]=4000;hm[6]=5000;hm[7]=6000;hm[8]=8000;
hpf[0]=40;hpf[1]=75;hpf[2]=125;hpf[3]=220;hpf[4]=400;
hf[0]=2000;hf[1]=3000;hf[2]=4000;hf[3]=5000;hf[4]=6000;hf[5]=8000;hf[6]=10000;hf[7]=12000;hf[8]=16000;
function coefficients(base,freq,gain,q) local(A,w,cs,sn,alpha,a0) (
  freq=max(10,min(freq,srate*0.475));
  A=exp(log(10)*gain/40);
  w=2*$pi*freq/srate;
  cs=cos(w);sn=sin(w);alpha=sn/(2*q);
  a0=1+alpha/A;
  base[0]=(1+alpha*A)/a0;
  base[1]=-2*cs/a0;
  base[2]=(1-alpha*A)/a0;
  base[3]=-2*cs/a0;
  base[4]=(1-alpha/A)/a0;
);
// RBJ-style shelving biquads, fixed shelf slope S=1.
function shelfcoeff(base,freq,gain,is_high) local(amp,w,cs,sn,alpha,beta,b0,b1,b2,a0,a1,a2) (
  freq=max(10,min(freq,srate*0.475));
  amp=exp(log(10)*gain/40);
  w=2*$pi*freq/srate;
  cs=cos(w);sn=sin(w);
  alpha=sn*0.5*sqrt(2);
  beta=2*sqrt(amp)*alpha;
  is_high ? (
    b0=amp*((amp+1)+(amp-1)*cs+beta);
    b1=-2*amp*((amp-1)+(amp+1)*cs);
    b2=amp*((amp+1)+(amp-1)*cs-beta);
    a0=(amp+1)-(amp-1)*cs+beta;
    a1=2*((amp-1)-(amp+1)*cs);
    a2=(amp+1)-(amp-1)*cs-beta;
  ) : (
    b0=amp*((amp+1)-(amp-1)*cs+beta);
    b1=2*amp*((amp-1)-(amp+1)*cs);
    b2=amp*((amp+1)-(amp-1)*cs-beta);
    a0=(amp+1)+(amp-1)*cs+beta;
    a1=-2*((amp-1)+(amp+1)*cs);
    a2=(amp+1)+(amp-1)*cs-beta;
  );
  base[0]=b0/a0; base[1]=b1/a0; base[2]=b2/a0;
  base[3]=a1/a0; base[4]=a2/a0;
);
function hpcoeff(base,freq) local(w,cs,sn,alpha,a0) (
  freq=max(10,min(freq,srate*0.475));
  w=2*$pi*freq/srate;
  cs=cos(w);sn=sin(w);
  alpha=sn/(2*0.7071067811865476);
  a0=1+alpha;
  base[0]=(1+cs)*0.5/a0;
  base[1]=-(1+cs)/a0;
  base[2]=(1+cs)*0.5/a0;
  base[3]=-2*cs/a0;
  base[4]=(1-alpha)/a0;
);
function biquad(base,state,x) local(y) (
  y=base[0]*x+state[0];
  state[0]=base[1]*x-base[3]*y+state[1];
  state[1]=base[2]*x-base[4]*y;
  y;
);
function refresh() (
  slider12 >= 0.5 ? shelfcoeff(c0,lf[slider1|0],slider2,0) : coefficients(c0,lf[slider1|0],slider2,1);
  coefficients(c1,lm[slider3|0],slider4,1);
  coefficients(c2,hm[slider5|0],slider6,1);
  slider13 >= 0.5 ? shelfcoeff(c3,hf[slider7|0],slider8,1) : coefficients(c3,hf[slider7|0],slider8,1);
  hpcoeff(hc,hpf[slider11|0]);
);
refresh();

@slider
refresh();

@block
// Rebuild coefficients even when parameters are changed from @gfx.
// This also catches automation and preset changes without relying on sliderchange.
refresh();

@sample
slider9 < 0.5 ? (
  xL=spl0;xR=spl1;
  slider10 >= 0.5 ? (xL=biquad(hc,hsL,xL);xR=biquad(hc,hsR,xR););
  xL=biquad(c0,s0L,xL);xR=biquad(c0,s0R,xR);
  xL=biquad(c1,s1L,xL);xR=biquad(c1,s1R,xR);
  xL=biquad(c2,s2L,xL);xR=biquad(c2,s2R,xR);
  spl0=biquad(c3,s3L,xL);spl1=biquad(c3,s3R,xR);
);

@gfx 760 485
function color(r,g,b) (gfx_set(r,g,b,1););
function txt(x,y,str) (gfx_x=x;gfx_y=y;gfx_drawstr(str););
function knob(x,y,r,value,lo,hi) local(a) (
  color(0.16,0.19,0.23);gfx_circle(x,y,r,1);
  color(0.35,0.41,0.47);gfx_circle(x,y,r,0);
  a=(-0.75+1.5*(value-lo)/(hi-lo))*$pi;
  color(0.26,0.84,0.74);
  gfx_line(x,y,x+cos(a)*r*0.76,y+sin(a)*r*0.76,3);
);
function band(x,label,idx,gain,arr,maxidx) local(f) (
  f=arr[idx|0];
  color(0.90,0.93,0.96);txt(x-36,88,label);
  knob(x,150,28,idx,0,maxidx);
  knob(x,260,28,gain,-12,12);
  color(0.63,0.70,0.76);txt(x-29,193,"FREQ");
  gfx_x=x-30;gfx_y=211;
  f>=1000 ? (gfx_drawnumber(f/1000,1);gfx_drawstr(" kHz");) : (gfx_drawnumber(f,0);gfx_drawstr(" Hz"););
  color(0.63,0.70,0.76);txt(x-24,304,"GAIN");
  gfx_x=x-29;gfx_y=324;gfx_drawnumber(gain,0);gfx_drawstr(" dB");
);
color(0.065,0.08,0.105);gfx_rect(0,0,gfx_w,gfx_h);
color(0.26,0.84,0.74);gfx_rect(0,0,gfx_w,5);
gfx_setfont(1,"Arial",24,'b');color(0.95,0.97,0.99);txt(24,20,"JMR AUDIO   /   EQ ONE");
gfx_setfont(1,"Arial",13);color(0.56,0.62,0.68);txt(25,56,"FOUR BAND STEPPED EQ  -  v1.5  /  LOW + HIGH BELL/SHELF");
band(100,"LOW",slider1,slider2,lf,11);
band(285,"LOW MID",slider3,slider4,lm,9);
band(470,"HIGH MID",slider5,slider6,hm,8);
band(655,"HIGH",slider7,slider8,hf,8);
// Mode buttons sit below the low/high bands.
slider12 >= 0.5 ? color(0.26,0.84,0.74) : color(0.35,0.41,0.47);
gfx_rect(56,351,90,29);
color(0.03,0.06,0.07);txt(67,358,slider12>=0.5 ? "SHELF" : "BELL");
slider13 >= 0.5 ? color(0.26,0.84,0.74) : color(0.35,0.41,0.47);
gfx_rect(611,351,90,29);
color(0.03,0.06,0.07);txt(622,358,slider13>=0.5 ? "SHELF" : "BELL");
color(0.56,0.62,0.68);txt(210,361,"DRAG VERTICALLY  |  Q = 1  |  1 dB STEPS");
color(0.13,0.16,0.19);gfx_rect(20,387,720,77);
color(0.95,0.97,0.99);txt(35,397,"HIGH PASS  /  12 dB PER OCTAVE");
knob(350,428,23,slider11,0,4);
color(0.63,0.70,0.76);txt(393,421,"FREQUENCY");
gfx_x=393;gfx_y=439;gfx_drawnumber(hpf[slider11|0],0);gfx_drawstr(" Hz");
slider10 >= 0.5 ? color(0.26,0.84,0.74) : color(0.35,0.41,0.47);
gfx_rect(625,407,94,42);
color(0.03,0.06,0.07);txt(640,421,slider10>=0.5 ? "HP ON" : "HP OFF");
slider9>=0.5 ? (color(1,0.44,0.39);txt(655,35,"BYPASSED"););
(mouse_cap & 1) ? (
  !dragging ? (
    dragging=1;start_y=mouse_y;which=0;
    mouse_x>=56 && mouse_x<=146 && mouse_y>=351 && mouse_y<=380 ? (slider12=1-slider12;sliderchange(1<<11););
    mouse_x>=611 && mouse_x<=701 && mouse_y>=351 && mouse_y<=380 ? (slider13=1-slider13;sliderchange(1<<12););
    abs(mouse_x-100)<38 ? (abs(mouse_y-150)<38 ? which=1 : abs(mouse_y-260)<38 ? which=2;);
    abs(mouse_x-285)<38 ? (abs(mouse_y-150)<38 ? which=3 : abs(mouse_y-260)<38 ? which=4;);
    abs(mouse_x-470)<38 ? (abs(mouse_y-150)<38 ? which=5 : abs(mouse_y-260)<38 ? which=6;);
    abs(mouse_x-655)<38 ? (abs(mouse_y-150)<38 ? which=7 : abs(mouse_y-260)<38 ? which=8;);
    which==1 ? start_v=slider1;
    which==2 ? start_v=slider2;
    which==3 ? start_v=slider3;
    which==4 ? start_v=slider4;
    which==5 ? start_v=slider5;
    which==6 ? start_v=slider6;
    which==7 ? start_v=slider7;
    which==8 ? start_v=slider8;
    abs(mouse_x-350)<30 && abs(mouse_y-428)<30 ? (which=11;start_v=slider11;);
    mouse_x>=625 && mouse_x<=719 && mouse_y>=407 && mouse_y<=449 ? (slider10=1-slider10;sliderchange(1<<9);which=0;);
  );
  which>0 ? (
    pix=which==11 ? 18 : (which%2 ? 12 : 8);
    v=floor(start_v+(start_y-mouse_y)/pix+0.5);
    which==1 ? slider1=max(0,min(11,v));
    which==2 ? slider2=max(-12,min(12,v));
    which==3 ? slider3=max(0,min(9,v));
    which==4 ? slider4=max(-12,min(12,v));
    which==5 ? slider5=max(0,min(8,v));
    which==6 ? slider6=max(-12,min(12,v));
    which==7 ? slider7=max(0,min(8,v));
    which==8 ? slider8=max(-12,min(12,v));
    which==11 ? slider11=max(0,min(4,v));
    sliderchange(1 << (which-1));
  );
) : (dragging=0;which=0;);
