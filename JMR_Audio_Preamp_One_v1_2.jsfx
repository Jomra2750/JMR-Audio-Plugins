desc:JMR Audio - Preamp One v1.2
// JMR Audio | Open. Adjust. Mix.
// v1.2: JMR dark custom UI; DSP and parameters retained from v1.1.
// Drive at 0 dB intentionally has character. No hardware emulation.

slider1:0<0,24,0.5>-Drive (dB)
slider2:0<0,2,1{Smooth,Warm,Aggressive}>-Character
slider3:1<0,1,1{Off,On}>-Auto Gain
slider4:0<-18,18,0.1>-Output (dB)
slider5:0<0,1,1{On,Bypass}>-Bypass

@init
pi2 = 1.5707963267948966;
function limit(v,lo,hi) (max(lo,min(hi,v)));
function update_params() (
  drive_gain = 10^(slider1/20);
  output_gain = 10^(slider4/20);
  slider2 == 0 ? (
    strength = 1.55;
    wet = 0.50;
  ) : slider2 == 1 ? (
    strength = 2.65;
    wet = 0.64;
  ) : (
    strength = 4.15;
    wet = 0.76;
  );
  auto_makeup = slider3 ? (1 + 0.23 * slider1 / 24) : 1;
  post_gain = output_gain * auto_makeup;
  amount = strength * drive_gain;
);
update_params();

@slider
update_params();

@sample
slider5 == 0 ? (
  inL = spl0;
  inR = spl1;
  shapedL = atan(amount * inL) / amount;
  shapedR = atan(amount * inR) / amount;
  spl0 = (inL * (1-wet) + shapedL * wet) * post_gain;
  spl1 = (inR * (1-wet) + shapedR * wet) * post_gain;
);

@gfx 650 300
function knob(x,y,val,lo,hi,label,value) local(t,ang) (
  gfx_set(0.13,0.17,0.21,1); gfx_circle(x,y,34,1);
  gfx_set(0.27,0.33,0.39,1); gfx_circle(x,y,27,1);
  t=limit((val-lo)/max(0.001,hi-lo),0,1);
  ang=(-0.75+1.5*t)*$pi;
  gfx_set(0.24,0.86,0.75,1); gfx_line(x,y,x+24*sin(ang),y-24*cos(ang),3);
  gfx_set(0.93,0.95,0.97,1); gfx_x=x-53; gfx_y=y+42; gfx_drawstr(label);
  gfx_set(0.45,0.91,0.81,1); gfx_x=x-53; gfx_y=y+61; gfx_drawstr(value);
);
function button(x,y,w,h,label,active) (
  active ? gfx_set(0.10,0.40,0.35,1) : gfx_set(0.22,0.26,0.30,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.95,0.97,0.97,1); gfx_x=x+12; gfx_y=y+12; gfx_drawstr(label);
);
function near(x,y,cx,cy) (abs(x-cx)<39 && abs(y-cy)<39);

// Consistent JMR palette, typography, and minimal controls.
gfx_set(0.07,0.09,0.12,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(0.19,0.86,0.75,1); gfx_x=22; gfx_y=16; gfx_drawstr("JMR AUDIO  /  PREAMP ONE");
gfx_set(0.57,0.64,0.69,1); gfx_x=22; gfx_y=40; gfx_drawstr("ORIGINAL PREAMP CHARACTER  |  V1.2");

knob(110,123,slider1,0,24,"DRIVE",sprintf(#drive,"%.1f dB",slider1));
knob(324,123,slider2,0,2,"CHARACTER",slider2==0 ? "SMOOTH" : slider2==1 ? "WARM" : "AGGRESSIVE");
knob(538,123,slider4,-18,18,"OUTPUT",sprintf(#output,"%+.1f dB",slider4));
button(111,227,182,40,slider3 ? "AUTO GAIN: ON" : "AUTO GAIN: OFF",slider3);
button(355,227,182,40,slider5 ? "PREAMP: BYPASS" : "PREAMP: ON",!slider5);
gfx_set(0.46,0.53,0.58,1); gfx_x=22; gfx_y=283; gfx_drawstr("DRAG KNOBS  /  SHIFT FOR FINE CONTROL");

pressed=mouse_cap&1;
fine=mouse_cap&8;
pressed && !waspressed ? (
  chosen=0;
  near(mouse_x,mouse_y,110,123) ? chosen=1;
  near(mouse_x,mouse_y,324,123) ? chosen=2;
  near(mouse_x,mouse_y,538,123) ? chosen=4;
  mouse_x>=111 && mouse_x<=293 && mouse_y>=227 && mouse_y<=267 ? (
    slider3=1-slider3; sliderchange(1<<2); update_params();
  );
  mouse_x>=355 && mouse_x<=537 && mouse_y>=227 && mouse_y<=267 ? (
    slider5=1-slider5; sliderchange(1<<4);
  );
  anchorY=mouse_y;
  chosen==1 ? anchorV=slider1;
  chosen==2 ? anchorV=slider2;
  chosen==4 ? anchorV=slider4;
);
pressed && chosen>0 ? (
  delta=anchorY-mouse_y;
  chosen==1 ? (
    slider1=limit(floor((anchorV+delta*(fine ? 0.01 : 0.04))*2+0.5)/2,0,24);
    sliderchange(1<<0);
  );
  chosen==2 ? (
    slider2=limit(floor(anchorV+delta*(fine ? 0.01 : 0.035)+0.5),0,2);
    sliderchange(1<<1);
  );
  chosen==4 ? (
    slider4=limit(floor((anchorV+delta*(fine ? 0.01 : 0.06))*10+0.5)/10,-18,18);
    sliderchange(1<<3);
  );
  update_params();
);
!pressed ? chosen=0;
waspressed=pressed;
