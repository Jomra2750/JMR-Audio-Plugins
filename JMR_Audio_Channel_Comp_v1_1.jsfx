desc:JMR Audio - Channel Comp v1.1
// Independent feed-forward channel compressor, SSL E-inspired workflow.
// Custom GUI. Stereo-linked detector; internal 12 dB/oct HP sidechain.

slider1:-18<-40,0,0.1>-Threshold (dB)
slider2:3<0,6,1{1.5:1,2:1,3:1,4:1,6:1,8:1,10:1}>-Ratio
slider3:2<0,5,1{0.1,0.3,1,3,10,30}>-Attack (ms)
slider4:2<0,5,1{50,100,200,400,800,1600}>-Release (ms)
slider5:0<0,1,1{Hard,Soft}>-Knee
slider6:1<0,1,1{Off,On}>-Auto Gain
slider7:0<-12,12,0.1>-Manual Makeup (dB)
slider8:0<0,5,1{Off,40,75,125,220,400}>-SC HP
slider9:1<0,1,1{Bypass,On}>-Compressor

@init
ratios[0]=1.5; ratios[1]=2; ratios[2]=3; ratios[3]=4; ratios[4]=6; ratios[5]=8; ratios[6]=10;
attacks=20; attacks[0]=0.1; attacks[1]=0.3; attacks[2]=1; attacks[3]=3; attacks[4]=10; attacks[5]=30;
releases=40; releases[0]=50; releases[1]=100; releases[2]=200; releases[3]=400; releases[4]=800; releases[5]=1600;
hpfreqs=60; hpfreqs[0]=0; hpfreqs[1]=40; hpfreqs[2]=75; hpfreqs[3]=125; hpfreqs[4]=220; hpfreqs[5]=400;
env=0; gain_db=0; gr_meter=0;
hp1x=0; hp1y=0; hp2x=0; hp2y=0;
last_sr=0; last_hp=-1;
function clamp(v,lo,hi) (max(lo,min(hi,v)));
function calc_hp() local(fc,w,cs,sn,alpha,a0) (
  fc=hpfreqs[floor(slider8+0.5)];
  fc>0 ? (
    w=2*$pi*min(fc,srate*0.45)/srate;
    cs=cos(w); sn=sin(w); alpha=sn/(2*0.70710678);
    a0=1+alpha;
    hb0=((1+cs)/2)/a0; hb1=(-(1+cs))/a0; hb2=hb0;
    ha1=(-2*cs)/a0; ha2=(1-alpha)/a0;
  );
);
function hp_left(x) local(y) (
  y=hb0*x+hb1*hp1x+hb2*hp2x-ha1*hp1y-ha2*hp2y;
  hp2x=hp1x; hp1x=x; hp2y=hp1y; hp1y=y;
  y;
);
function calc_params() (
  ratio=ratios[floor(slider2+0.5)];
  atk=exp(-1/(max(0.1,attacks[floor(slider3+0.5)])*0.001*srate));
  rel=exp(-1/(releases[floor(slider4+0.5)]*0.001*srate));
  threshold=slider1;
  // Static, capped approximation of level compensation at -18 dBFS reference.
  ref_db=max(-18,threshold+6);
  auto_makeup=slider6 ? clamp((ref_db-threshold)*(1-1/ratio)*0.65,0,12) : 0;
  makeup_lin=10^((slider7+auto_makeup)/20);
);

@slider
calc_params();
(slider8 != last_hp || srate != last_sr) ? (
  calc_hp(); hp1x=hp2x=hp1y=hp2y=0;
  last_hp=slider8; last_sr=srate;
);

@block
calc_params();
(slider8 != last_hp || srate != last_sr) ? (
  calc_hp(); hp1x=hp2x=hp1y=hp2y=0;
  last_hp=slider8; last_sr=srate;
);

@sample
slider9 ? (
  // Mono linked detector, identical attenuation for L and R.
  detect=(spl0+spl1)*0.5;
  slider8>0 ? detect=hp_left(detect);
  level=abs(detect);
  env=level>env ? atk*env+(1-atk)*level : rel*env+(1-rel)*level;
  in_db=20*log10(max(env,0.000000001));
  over=in_db-threshold;
  slider5 ? (
    // 6 dB soft knee centered at threshold.
    over<=-3 ? reduction=0 : over>=3 ? reduction=over*(1-1/ratio) : reduction=(over+3)^2/12*(1-1/ratio);
  ) : (
    reduction=max(0,over)*(1-1/ratio);
  );
  target_db=-reduction;
  // Envelope detector is already smoothed; gain applied without discontinuous jumps.
  g=10^(target_db/20)*makeup_lin;
  spl0*=g; spl1*=g;
  gr_meter += (reduction-gr_meter)*0.003;
) : (
  gr_meter*=0.999;
);

@gfx 680 365
function knob(x,y,v,minv,maxv,label,value) local(angle,t) (
  gfx_set(0.15,0.18,0.22,1); gfx_circle(x,y,30,1);
  gfx_set(0.28,0.33,0.38,1); gfx_circle(x,y,24,1);
  t=clamp((v-minv)/max(0.001,maxv-minv),0,1);
  angle=(-0.75+t*1.5)*$pi;
  gfx_set(0.22,0.86,0.78,1);
  gfx_line(x,y,x+22*sin(angle),y-22*cos(angle),3);
  gfx_set(0.93,0.95,0.96,1); gfx_x=x-46; gfx_y=y+36; gfx_drawstr(label);
  gfx_set(0.48,0.92,0.84,1); gfx_x=x-46; gfx_y=y+52; gfx_drawstr(value);
);
function btn(x,y,w,h,label,active) (
  active ? gfx_set(0.10,0.40,0.38,1) : gfx_set(0.20,0.23,0.27,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.95,0.97,0.97,1); gfx_x=x+10; gfx_y=y+9; gfx_drawstr(label);
);
function hit(x,y,cx,cy) (abs(x-cx)<36 && abs(y-cy)<36);

// Full background and title.
gfx_set(0.07,0.09,0.12,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(0.17,0.84,0.75,1); gfx_x=22; gfx_y=15; gfx_drawstr("JMR AUDIO  /  CHANNEL COMP");
gfx_set(0.60,0.65,0.68,1); gfx_x=22; gfx_y=38; gfx_drawstr("DISCRETE-STYLE CHANNEL DYNAMICS  |  V1.1");

knob(85,112,slider1,-40,0,"THRESH",sprintf(#display,"%.1f dB",slider1));
knob(190,112,slider2,0,6,"RATIO",sprintf(#display,"%.1f:1",ratios[floor(slider2+0.5)]));
knob(295,112,slider3,0,5,"ATTACK",sprintf(#display,"%.1f ms",attacks[floor(slider3+0.5)]));
knob(400,112,slider4,0,5,"RELEASE",sprintf(#display,"%.0f ms",releases[floor(slider4+0.5)]));
knob(505,112,slider7,-12,12,"MAKEUP",sprintf(#display,"%+.1f dB",slider7));
knob(610,112,slider8,0,5,"SC HP",slider8 ? sprintf(#display,"%.0f Hz",hpfreqs[floor(slider8+0.5)]) : "OFF");
btn(35,235,115,37,slider5 ? "KNEE: SOFT" : "KNEE: HARD",slider5);
btn(166,235,128,37,slider6 ? "AUTO GAIN ON" : "AUTO GAIN OFF",slider6);
btn(310,235,125,37,slider9 ? "COMP: ON" : "COMP: BYPASS",slider9);

gfx_set(0.84,0.88,0.89,1); gfx_x=465; gfx_y=230; gfx_drawstr("GAIN REDUCTION");
gfx_set(0.20,0.24,0.28,1); gfx_rect(465,251,184,16);
gfx_set(0.18,0.84,0.74,1); gfx_rect(465,251,184*clamp(gr_meter/24,0,1),16);
gfx_set(0.82,0.9,0.88,1); gfx_x=465; gfx_y=276; gfx_drawstr(sprintf(#display,"%.1f dB  |  AUTO +%.1f dB",gr_meter,auto_makeup));
gfx_set(0.46,0.52,0.57,1); gfx_x=24; gfx_y=325; gfx_drawstr("DRAG KNOBS UP/DOWN  |  SHIFT = FINE  |  CLICK BUTTONS TO TOGGLE");

// Mouse capture: select control on press, update continuously while dragging.
press=mouse_cap&1;
shift=mouse_cap&8;
press && !oldpress ? (
  selected=0;
  hit(mouse_x,mouse_y,85,112) ? selected=1;
  hit(mouse_x,mouse_y,190,112) ? selected=2;
  hit(mouse_x,mouse_y,295,112) ? selected=3;
  hit(mouse_x,mouse_y,400,112) ? selected=4;
  hit(mouse_x,mouse_y,505,112) ? selected=7;
  hit(mouse_x,mouse_y,610,112) ? selected=8;
  mouse_y>=235 && mouse_y<=272 ? (
    mouse_x>=35 && mouse_x<=150 ? (slider5=1-slider5; sliderchange(1<<4););
    mouse_x>=166 && mouse_x<=294 ? (slider6=1-slider6; sliderchange(1<<5););
    mouse_x>=310 && mouse_x<=435 ? (slider9=1-slider9; sliderchange(1<<8););
  );
  anchor_y=mouse_y;
  selected==1 ? anchor_v=slider1;
  selected==2 ? anchor_v=slider2;
  selected==3 ? anchor_v=slider3;
  selected==4 ? anchor_v=slider4;
  selected==7 ? anchor_v=slider7;
  selected==8 ? anchor_v=slider8;
);
press && selected>0 ? (
  delta=(anchor_y-mouse_y)*(shift ? 0.0125 : 0.12);
  selected==1 ? (slider1=clamp(anchor_v+delta,-40,0); sliderchange(1<<0););
  selected==2 ? (slider2=clamp(floor(anchor_v+delta+0.5),0,6); sliderchange(1<<1););
  selected==3 ? (slider3=clamp(floor(anchor_v+delta+0.5),0,5); sliderchange(1<<2););
  selected==4 ? (slider4=clamp(floor(anchor_v+delta+0.5),0,5); sliderchange(1<<3););
  selected==7 ? (slider7=clamp(anchor_v+delta,-12,12); sliderchange(1<<6););
  selected==8 ? (slider8=clamp(floor(anchor_v+delta+0.5),0,5); sliderchange(1<<7););
);
!press ? selected=0;
oldpress=press;
